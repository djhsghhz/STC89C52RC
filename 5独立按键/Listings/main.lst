  12          #include "reg52.h"
  13          
  14          typedef unsigned int u16; //对系统默认数据类型进行重定义
  15          typedef unsigned char u8;
  16          
  17          //定义独立按键控制脚
  18          sbit KEY1=P3^1;
  19          sbit KEY2=P3^0;
  20          sbit KEY3=P3^2;
  21          sbit KEY4=P3^3;
  22          
  23          //定义LED1控制脚
  24          sbit LED1=P2^0;
  25          
  26          //使用宏定义独立按键按下的键值
  27          #define KEY1_PRESS  1
  28          #define KEY2_PRESS  2
  29          #define KEY3_PRESS  3
  30          #define KEY4_PRESS  4
  31          #define KEY_UNPRESS 0 
  32          
  33          /*******************************************************************************
  34          * 函 数 名       : delay_10us
  35          * 函数功能     : 延时函数，ten_us=1时，大约延时10us
  36          * 输    入       : ten_us
  37          * 输    出       : 无
  38          *******************************************************************************/
  39          void delay_10us(u16 ten_us)
  40          {
  41   1        while(ten_us--);  
  42   1      }
  43          
  44          /*******************************************************************************
  45          * 函 数 名       : key_scan
  46          * 函数功能     : 检测独立按键是否按下，按下则返回对应键值
  47          * 输    入       : mode=0：单次扫描按键
  48                     mode=1：连续扫描按键
  49          * 输    出       : KEY1_PRESS：K1按下
  50                     KEY2_PRESS：K2按下
  51                     KEY3_PRESS：K3按下
  52                     KEY4_PRESS：K4按下
  53                     KEY_UNPRESS：未有按键按下
  54          *******************************************************************************/
C51 COMPILER V9.60.7.0   MAIN                                                              04/30/2025 12:30:50 PAGE 2   

  55          u8 key_scan(u8 mode)
  56          {
  57   1        static u8 key=1;
  58   1      
  59   1        if(mode)key=1;//连续扫描按键
  60   1        if(key==1&&(KEY1==0||KEY2==0||KEY3==0||KEY4==0))//任意按键按下
  61   1        {
  62   2          delay_10us(1000);//消抖
  63   2          key=0;
  64   2          if(KEY1==0)
  65   2            return KEY1_PRESS;
  66   2          else if(KEY2==0)
  67   2            return KEY2_PRESS;
  68   2          else if(KEY3==0)
  69   2            return KEY3_PRESS;
  70   2          else if(KEY4==0)
  71   2            return KEY4_PRESS;  
  72   2        }
  73   1        else if(KEY1==1&&KEY2==1&&KEY3==1&&KEY4==1) //无按键按下
  74   1        {
  75   2          key=1;      
  76   2        }
  77   1        return KEY_UNPRESS;   
  78   1      }
  79          /*******************************************************************************
  80          * 函 数 名       : main
  81          * 函数功能     : 主函数
  82          * 输    入       : 无
  83          * 输    出       : 无
  84          *******************************************************************************/
  85          void main()
  86          { 
  87   1        u8 key=0;
  88   1      
  89   1        while(1)
  90   1        {
  91   2            key=key_scan(0);
  92   2          if(key==KEY1_PRESS)//检测按键K1是否按下
  93   2            LED1=!LED1;//LED1状态翻转 
  94   2        }   
  95   1      }


